<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Build -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Package Identity -->
    <PackageId>Sorophy.Engine</PackageId>
    <Version>1.0.0</Version>

    <!-- Stable Release Grade -->
    <PackageReleaseNotes>
      1.0.0 Stable — Grade A (Silver Standard).
      Verified against the documented Sorophy™ v1 release scope,
      including graph correctness, mutation integrity, serialization,
      persistence, recovery, memory behavior, scaling, fuzzing,
      pooling, and endurance testing.
    </PackageReleaseNotes>

    <!-- Package Metadata -->
    <Title>Sorophy</Title>
    <Authors>Subhradeep Sarkar</Authors>
    <Description>
      Sorophy™ is the reference implementation of The Saga Architecture,
      providing structured entities, relationships, typed values, graph operations,
      serialization, and storage for interconnected structured information.
    </Description>

    <PackageTags>
      sorophy;saga;engine;dotnet;dotnet10;csharp;graph;knowledge-graph;structured-data;serialization;storage;worldbuilding
    </PackageTags>

    <!-- License -->
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>

    <!-- Repository -->
    <RepositoryUrl>https://github.com/Phantom-Con-Artist/Sorophy.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Phantom-Con-Artist/Sorophy</PackageProjectUrl>

    <!-- Documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  

    <!-- NuGet -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Release Configuration -->
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- Legal license text is included in the package. -->
    <None Include="LICENSE"
          Pack="true"
          PackagePath="\" />
  </ItemGroup>

</Project>