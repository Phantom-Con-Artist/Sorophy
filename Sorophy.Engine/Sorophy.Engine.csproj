<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Build -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Package Identity -->
    <PackageId>Sorophy.Engine</PackageId>
    <Version>2.0.0</Version>

    <!-- Stable Release Grade -->
    <PackageReleaseNotes>
      Sorophy Engine v2.0.0 "Krono" — Stable - S (Gold Standard).

      Verified against the documented Sorophy Engine release scope,
      including graph correctness, mutation integrity, temporal modeling,
      evolution and history, provenance, snapshots, temporal queries,
      graph diff, serialization, persistence, recovery, memory behavior,
      scaling, fuzzing, adversarial testing, metamorphic testing,
      cross-feature validation, endurance testing, and cross-platform
      persistence portability.

      Cross-platform persistence has been validated through an actual
      Windows → Linux → macOS → Windows .lore artifact handoff using
      GitHub Actions.
    </PackageReleaseNotes>

    <!-- Package Metadata -->
    <Title>Sorophy Engine</Title>
    <Authors>Subhradeep Sarkar</Authors>
    <Description>
      Sorophy Engine is the core engine of Sorophyis, providing structured entities,
      relationships, typed values, graph operations, serialization, and storage
      for interconnected structured information.
    </Description>

    <PackageTags>
      sorophyis;sorophy;engine;dotnet;dotnet10;csharp;graph;knowledge-graph;structured-data;serialization;storage;worldbuilding
    </PackageTags>

    <!-- NuGet Package Icon -->
    <PackageIcon>package-icon.png</PackageIcon>

    <!-- License -->
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>

    <!-- Repository -->
    <RepositoryUrl>https://github.com/Phantom-Con-Artist/Sorophy.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Phantom-Con-Artist/Sorophy</PackageProjectUrl>

    <!-- Documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- NuGet -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Release Configuration -->
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- Legal license text is included in the package. -->
    <None Include="LICENSE"
          Pack="true"
          PackagePath="\" />

    <!-- NuGet package icon. -->
    <None Include="..\package-icon.png"
          Pack="true"
          PackagePath="\" />
  </ItemGroup>

</Project>
